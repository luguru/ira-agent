# Servidor web local
HOST=127.0.0.1
PORT=4173

# Mantener en false salvo que se auditen redes internas en un entorno controlado.
IRA_ALLOW_PRIVATE_NETWORKS=false

# Resumen mediante IA, desactivado por defecto.
ENABLE_AI_SUMMARY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Credenciales de prueba para flujos autenticados (no commitear secretos reales).
IRA_AUDIT_USER=
IRA_AUDIT_PASSWORD=

# Mock local para validar escenarios private/auth (opcional).
MOCK_SITE_HOST=127.0.0.1
MOCK_SITE_PORT=4410
