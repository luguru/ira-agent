{
  "name": "ira-agent",
  "version": "0.5.0",
  "description": "Agente local para análisis automático de accesibilidad y generación de informe IRA automático.",
  "type": "module",
  "scripts": {
    "audit": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "web": "tsx src/web-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "test:report": "tsx --test tests/report-html.test.ts",
    "preview:report": "tsx tests/preview-report.ts",
    "preview:report:open": "npm run preview:report && open runs/mock-preview/report.html",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "clean": "node -e \"require('fs').rmSync('runs', { recursive: true, force: true })\"",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "accessibility",
    "wcag",
    "ira",
    "axe-core",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "openai": "^6.48.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luguru/ira-agent.git"
  },
  "bugs": {
    "url": "https://github.com/luguru/ira-agent/issues"
  },
  "homepage": "https://github.com/luguru/ira-agent#readme"
}
