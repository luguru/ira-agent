{
  "name": "ira-agent",
  "version": "0.1.0",
  "description": "Agente local para análisis automático de accesibilidad y generación de informe IRA automático.",
  "type": "module",
  "scripts": {
    "audit": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "clean": "node -e \"require('fs').rmSync('runs', { recursive: true, force: true })\""
  },
  "keywords": [
    "accessibility",
    "wcag",
    "ira",
    "axe-core",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "openai": "^6.48.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}