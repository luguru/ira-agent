+    if (!/^[0-9a-f]{1,4}$/.test(rawPart)) {
+      return null;
+    }
+    parts.push(Number.parseInt(rawPart, 16));
+  }
+  return parts;
+}
+
+function isRedirect(statusCode: number): boolean {
+  return statusCode >= 300 && statusCode < 400;
+}
